# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# APP2_REVIEW_PASSCODE: Authorised access passcode for human review.
# Configure this via the Secrets panel in the AI Studio UI.
APP2_REVIEW_PASSCODE="1111"

# GEMINI_MODEL: The model name to use for extraction (e.g. gemini-3.6-flash).
# If not provided, the app will auto-select the best available model.
GEMINI_MODEL="gemini-3.6-flash"

# MICROSOFT_CLIENT_ID: Your Microsoft Entra ID Application (client) ID.
MICROSOFT_CLIENT_ID="YOUR_MICROSOFT_CLIENT_ID"

# MICROSOFT_CLIENT_SECRET: Your Microsoft Entra ID Client Secret.
MICROSOFT_CLIENT_SECRET="YOUR_MICROSOFT_CLIENT_SECRET"

# SESSION_SECRET: A random string for securing sessions.
SESSION_SECRET="some-random-secret"
